generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Trade {
  id           String   @id @default(cuid())
  userId       String
  externalId   String?  @unique // Order ID from broker CSV — used for dedup on re-import
  symbol       String
  side         String   // "long" | "short"
  assetClass   String   // "stocks" | "options" | "crypto" | "forex" | "futures"
  entryPrice   Float
  exitPrice    Float
  quantity     Float
  entryDate    DateTime
  exitDate     DateTime
  pnl          Float
  notes        String?
  tags         String[]
  screenshotUrl String?
  autoNote         String?  @db.Text
  autoNoteAt       DateTime?
  flaggedForReview Boolean  @default(false)
  flagReason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model TradeAttachment {
  id        String   @id @default(cuid())
  tradeId   String
  fileName  String
  fileType  String
  fileSize  Int
  url       String   @db.Text  // base64 data URL
  createdAt DateTime @default(now())

  @@index([tradeId])
}

model AgentMemory {
  id         String   @id @default(cuid())
  userId     String
  agentType  String
  memories   Json
  rawSummary String   @db.Text
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, agentType])
}

model TradingInsight {
  id            String   @id @default(cuid())
  userId        String
  title         String
  content       String   @db.Text
  category      String
  relatedTrades String[]
  savedAt       DateTime @default(now())
  agentType     String
  thumbsUp      Int      @default(0)
  thumbsDown    Int      @default(0)
}

model DailyBriefing {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String   @db.Text
  vixLevel  Float?
  spyPrice  Float?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model WatchlistItem {
  id         String  @id @default(cuid())
  userId     String
  symbol     String
  notes      String?
  alertPrice Float?
  createdAt  DateTime @default(now())

  @@unique([userId, symbol])
}

model JournalEntry {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @unique
  mood        Int      // 1-5
  notes       String
  marketBias  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
